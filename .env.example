# Estas variables NO se leen automáticamente (es JS vanilla sin build step),
# son una referencia de qué necesitas configurar y dónde.

# ---- En public/js/config.js (públicas, van al navegador) ----
# WORKER_URL=https://gd-place-worker.tu-cuenta.workers.dev
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=eyJ... (clave "anon public" del dashboard de Supabase)

# ---- Como secretos del Worker (wrangler secret put NOMBRE) ----
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (clave "service_role", NUNCA la expongas al cliente)
# SESSION_SECRET=una-cadena-aleatoria-larga (reservado para cuando se firmen tokens)

# ---- En worker/wrangler.toml ----
# database_id de tu D1 (wrangler d1 create gd-place-db)
